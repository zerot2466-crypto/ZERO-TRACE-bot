# Copiez ce fichier vers .env puis renseignez uniquement vos propres valeurs.
# Ne committez jamais .env et ne partagez jamais vos tokens.

# Telegram — obligatoire pour démarrer le contrôleur Telegram
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# Identifiant Telegram numérique autorisé à utiliser les commandes owner
OWNER_TELEGRAM_ID=YOUR_TELEGRAM_USER_ID

# Le numéro owner WhatsApp est verrouillé dans config.js.
# Ne renseignez pas OWNER_NUMBER ni OWNER_NUMBERS ici.

# Identité et comportement du bot
BOT_NAME=ZERO TRACE
OWNER_NAME=YOUR_NAME
HOSTING_NAME=YOUR_HOSTING_NAME
PREFIX=.
TELEGRAM_HANDLE=@YOUR_TELEGRAM_HANDLE
MAX_PAIRED_USERS=20
# Laissez vide si vous ne souhaitez pas rejoindre automatiquement un groupe
AUTO_JOIN_GROUP_INVITE=
# JID de newsletter WhatsApp facultatif
NEWSLETTER_JID=

# Services externes — facultatifs, selon les commandes utilisées
KAIZ_API_KEY=YOUR_KAIZ_API_KEY
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY
HEAVSTAL_API_KEY=YOUR_HEAVSTAL_API_KEY
REMOVE_BG_API_KEY=YOUR_REMOVE_BG_API_KEY

# Consultez le README pour les liens officiels d'obtention des clés.
